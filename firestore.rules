rules_version = '2';

// Land Installment Tracker — Firestore security rules.
//
// Deploy: Firebase Console → Firestore Database → Rules → paste → Publish
// (or `firebase deploy --only firestore:rules` if you have CLI access).
//
// Roles live only on each member's own doc (groups/{id}/members/{uid}.role)
// — creator / admin / collector / member. The group document itself only
// keeps memberIds (who can read/list it) and createdBy (who can manage it).
// Permissions:
//   creator   — everything: edit plan, add/remove members, change roles,
//               delete the group, plus every ability below.
//   admin     — approve/reject a pending entry, cancel an approved entry,
//               view the audit log.
//   collector — approve/reject a pending entry, record builder payments.
//   member    — submit their own entries (status is readable by everyone,
//               regardless of role).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Membership/role checks need a get() on the group or member doc — fine
    // for single-document read/write/delete rules. (The one place this
    // pattern breaks is a *list* query's own `allow read`, which is why
    // groups/{groupId}'s read/update/delete below use resource.data
    // directly instead of these helpers.)
    function isGroupMember(groupId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    function myRole(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role;
    }

    function isGroupCreator(groupId) {
      return isSignedIn() && myRole(groupId) == 'creator';
    }

    // Approve/reject a pending contribution entry.
    function isGroupApprover(groupId) {
      return isSignedIn() && myRole(groupId) in ['creator', 'admin', 'collector'];
    }

    // Cancel an already-approved entry; view the audit log.
    function isGroupCanceller(groupId) {
      return isSignedIn() && myRole(groupId) in ['creator', 'admin'];
    }

    // Record a builder payment.
    function isGroupCollectorRole(groupId) {
      return isSignedIn() && myRole(groupId) in ['creator', 'collector'];
    }

    // A group's Creator/Admin correcting another member's display name or
    // profile email from that group's Members tab (there's no self-service
    // profile editor). [groupId] here is a value the *write itself*
    // supplies (see isGroupManagerEditingMember below) — not a path
    // segment — so it can't reuse myRole()/isGroupCanceller() above, which
    // read it out of the match block's own {groupId}.
    function isGroupManagerEditingUser(groupId, targetUid) {
      return isSignedIn() && groupId != null &&
        targetUid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds &&
        get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role
          in ['creator', 'admin'];
    }

    // Each field may only ever change together with its own groupId proof
    // field, one at a time — never phone/photoUrl, and never both name and
    // email in the same write, which stay owner-only / two separate calls.
    function isGroupManagerEditingMember(targetUid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (
        changed.hasOnly(['name', 'nameLastEditedByGroupId']) &&
        isGroupManagerEditingUser(request.resource.data.get('nameLastEditedByGroupId', null), targetUid)
      ) || (
        changed.hasOnly(['email', 'emailLastEditedByGroupId']) &&
        isGroupManagerEditingUser(request.resource.data.get('emailLastEditedByGroupId', null), targetUid)
      );
    }

    // ---------------------------------------------------------------
    // users/{uid} — profile. Any signed-in user may read (needed for
    // member-name lookups and the "add member by phone/email" search);
    // only the owner may write their own document — except a group's
    // Creator/Admin may also correct another member's name/email (above).
    // ---------------------------------------------------------------
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() &&
        (request.auth.uid == uid || isGroupManagerEditingMember(uid));
      allow delete: if false;

      match /fcmTokens/{tokenId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }

      // The in-header notification bell's inbox — only ever written by
      // functions/index.js via the Admin SDK, which bypasses these rules
      // entirely, so create is always false here. The owner may mark
      // entries read (and only that field) or clear their own inbox.
      match /notifications/{notifId} {
        allow read, delete: if isSignedIn() && request.auth.uid == uid;
        allow create: if false;
        allow update: if isSignedIn() && request.auth.uid == uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      }
    }

    // ---------------------------------------------------------------
    // groups/{groupId}
    // ---------------------------------------------------------------
    match /groups/{groupId} {
      // Read directly off resource.data instead of a get()-based helper:
      // for a *list* query (watchUserGroups), Firestore must prove from the
      // rule alone that every possible match is readable, and a rule that
      // re-fetches the same document via get() isn't guaranteed to satisfy
      // that check the way a direct resource.data read does.
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      // Creation: the creator must be listing themselves as the sole member
      // and as createdBy (matches GroupService.createGroup).
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.memberIds &&
        request.resource.data.createdBy == request.auth.uid;
      // Group management (plan edits) and deletion are Creator-only.
      allow update: if isSignedIn() && request.auth.uid == resource.data.createdBy;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.createdBy;

      match /members/{memberUid} {
        allow read: if isGroupMember(groupId);
        // Bootstrapping: isGroupCreator() can't gate the very first member
        // doc (the creator's own) — myRole() reads this exact doc via
        // get(), and it doesn't exist yet while it's being created, so the
        // check always evaluated to false and blocked every group's first
        // member write. Allow the group's creator to create ONLY their own
        // doc, with role 'creator', verified against the group doc's
        // createdBy field instead (which is already written by then).
        // Every other member write (adding others, role changes, exits,
        // any update/delete) requires isGroupCreator(), which works from
        // here on since the creator's own member doc now exists.
        allow create: if isGroupCreator(groupId) ||
          (isSignedIn() &&
            request.auth.uid == memberUid &&
            request.resource.data.role == 'creator' &&
            get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid);
        allow update, delete: if isGroupCreator(groupId);
      }

      match /planHistory/{entryId} {
        allow read: if isGroupMember(groupId);
        allow write: if isGroupCreator(groupId);
      }

      match /contributions/{contributionId} {
        allow read: if isGroupMember(groupId);
        // Submit: any member, only for themselves, always starting
        // "pendingConfirmation". Receipt photo is optional.
        allow create: if isGroupMember(groupId) &&
          request.resource.data.memberId == request.auth.uid &&
          request.resource.data.submittedBy == request.auth.uid &&
          request.resource.data.status == 'pendingConfirmation';
        allow update: if isGroupMember(groupId) && (
          // Approve/reject: an Admin/Collector/Creator who is NOT the
          // submitter or the member the entry belongs to (Maker-Checker).
          (isGroupApprover(groupId) &&
            resource.data.status == 'pendingConfirmation' &&
            resource.data.submittedBy != request.auth.uid &&
            resource.data.memberId != request.auth.uid &&
            request.resource.data.status in ['approved', 'rejected']) ||
          // Cancel: an Admin/Creator voiding an entry that was approved.
          (isGroupCanceller(groupId) &&
            resource.data.status == 'approved' &&
            request.resource.data.status == 'cancelled')
        );
        // Only ever deleted as part of the Creator deleting the whole group.
        allow delete: if isGroupCreator(groupId);
      }

      match /builderPayments/{paymentId} {
        allow read: if isGroupMember(groupId);
        allow create, update: if isGroupCollectorRole(groupId);
        allow delete: if isGroupCreator(groupId);
      }

      match /auditLog/{logId} {
        // Admin/Creator only, per the role restructure.
        allow read: if isGroupCanceller(groupId);
        // Append-only, and the actor must be the writer themselves — every
        // service method logs as request.auth.uid right after its own
        // guarded write, so this never blocks a legitimate action.
        allow create: if isGroupMember(groupId) && request.resource.data.actorId == request.auth.uid;
        allow update: if false;
        allow delete: if isGroupCreator(groupId);
      }
    }
  }
}
