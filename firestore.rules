rules_version = '2';

// Land Installment Tracker — Firestore security rules.
//
// Deploy with: firebase deploy --only firestore:rules (after `firebase use
// --add` points the CLI at your project — see README.md "Firebase setup").
//
// Mirrors the app's roles: every group document lists memberIds (readable
// by any of them) and adminIds (who may write group/plan/member/
// builder-payment data). Contribution approval additionally enforces
// Maker-Checker: the approver can never be the same person who submitted
// the entry or the member it's for (FR Finalized Decision 2/3).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isGroupMember(groupId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    function isGroupAdmin(groupId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.adminIds;
    }

    // ---------------------------------------------------------------
    // users/{uid} — profile. Any signed-in user may read (needed for
    // member-name lookups and the "add member by phone/email" search);
    // only the owner may write their own document.
    // ---------------------------------------------------------------
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;

      match /fcmTokens/{tokenId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // ---------------------------------------------------------------
    // groups/{groupId}
    // ---------------------------------------------------------------
    match /groups/{groupId} {
      // Read directly off resource.data instead of the isGroupMember()
      // get()-based helper: for a *list* query (watchUserGroups), Firestore
      // must prove from the rule alone that every possible match is
      // readable, and a rule that re-fetches the same document via get()
      // isn't guaranteed to satisfy that check the way a direct
      // resource.data read does — this was silently blocking
      // "my groups" list reads even though group creation itself succeeded.
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      // Creation: the creator must be listing themselves as the sole
      // member+admin at create time (matches GroupService.createGroup).
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.memberIds &&
        request.auth.uid in request.resource.data.adminIds;
      allow update: if isSignedIn() && request.auth.uid in resource.data.adminIds;
      allow delete: if false;

      match /members/{memberUid} {
        allow read: if isGroupMember(groupId);
        // Only Admins manage membership (role, monthly amount, exit) — the
        // very first member (the creator) already satisfies isGroupAdmin
        // because the group document itself (with them in adminIds) is
        // written first, in the same create-group call.
        allow write: if isGroupAdmin(groupId);
      }

      match /planHistory/{entryId} {
        allow read: if isGroupMember(groupId);
        allow write: if isGroupAdmin(groupId);
      }

      match /contributions/{contributionId} {
        allow read: if isGroupMember(groupId);
        // Submit: any member, only for themselves, always starting
        // "pendingConfirmation".
        allow create: if isGroupMember(groupId) &&
          request.resource.data.memberId == request.auth.uid &&
          request.resource.data.submittedBy == request.auth.uid &&
          request.resource.data.status == 'pendingConfirmation';
        // Approve/reject: an Admin who is NOT the submitter or the member
        // the entry belongs to (Maker-Checker), moving only from
        // "pendingConfirmation" to a terminal state, and only when a
        // receipt is already attached.
        allow update: if isGroupAdmin(groupId) &&
          resource.data.status == 'pendingConfirmation' &&
          resource.data.submittedBy != request.auth.uid &&
          resource.data.memberId != request.auth.uid &&
          resource.data.receiptUrl != null &&
          request.resource.data.status in ['approved', 'rejected'];
        allow delete: if false;
      }

      match /builderPayments/{paymentId} {
        allow read: if isGroupMember(groupId);
        allow create, update: if isGroupAdmin(groupId);
        allow delete: if false;
      }

      match /auditLog/{logId} {
        allow read: if isGroupMember(groupId);
        // Append-only, and the actor must be the writer themselves — every
        // service method logs as request.auth.uid right after its own
        // guarded write, so this never blocks a legitimate action.
        allow create: if isGroupMember(groupId) && request.resource.data.actorId == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
