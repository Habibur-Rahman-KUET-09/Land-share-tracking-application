rules_version = '2';

// Land Installment Tracker — Cloud Storage security rules (receipt
// uploads). Deploy with: firebase deploy --only storage.
//
// Uses the cross-service `firestore.get()` function to check group
// membership the same way firestore.rules does, so a receipt is only
// readable/writable by that group's own members.
service firebase.storage {
  match /b/{bucket}/o {
    function isGroupMember(groupId) {
      return request.auth != null &&
        request.auth.uid in firestore.get(/databases/(default)/documents/groups/$(groupId)).data.memberIds;
    }

    match /groups/{groupId}/receipts/{fileName} {
      allow read: if isGroupMember(groupId);
      allow write: if isGroupMember(groupId) &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }
  }
}
