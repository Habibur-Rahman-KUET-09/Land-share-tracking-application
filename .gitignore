**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Cloud Functions (functions/)
functions/node_modules/
functions/.env
functions/.env.*

# Firebase CLI local state
.firebase/
.firebaserc
firebase-debug.log
firestore-debug.log
ui-debug.log

# Play upload signing key — never commit these. The keystore reaches CI as a
# base64 GitHub secret (see .github/workflows/build-apk.yml); key.properties
# is written from secrets at build time, or created by hand for local
# release builds. android/app/debug.keystore is deliberately NOT here: it is
# a throwaway debug key, committed on purpose so every build shares one SHA-1.
android/key.properties
*.jks
*.keystore
!android/app/debug.keystore

# Held back until the privacy contact address is decided — publishing a
# policy with a placeholder in it is worse than not publishing one yet.
web/privacy.html
